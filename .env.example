# ── MEMEDESK settings ────────────────────────────────────────────────────────
# paper = fake money on real market data (default). live = real money.
MODE=paper

# Free Helius key (helius.dev). Needed for Raydium pool scanning + reliable RPC.
HELIUS_API_KEY=

# Optional: Jupiter API key (portal.jup.ag) for higher quote rate limits
JUP_API_KEY=

# Paper account size in SOL
PAPER_START_SOL=10

# Morning recap (sent to Telegram if both are set; always saved to recaps/)
RECAP_TZ=America/New_York
RECAP_HOUR=7
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Hard limits ─────────────────────────────────────────────────────────────
# These can be made STRICTER here, never looser (the code clamps them):
#   MAX_POSITION_PCT=0.08  STOP_LOSS_PCT=0.06  MIN_ANALYST_SCORE=0.6
#   TOP10_MAX_PCT=20  MIN_VOLUME_H1_USD=50000  MIN_LP_LOCKED_PCT=95
# Trailing: arms at +12% (fixed). Distance below peak once armed:
TRAIL_DISTANCE_PCT=0.06

# Extra capital-preservation guards (tunable)
MAX_OPEN_POSITIONS=3
MAX_POOL_SHARE_PCT=1.5
DAILY_LOSS_HALT_PCT=12
LOSS_STREAK_COOLDOWN_MIN=45
LOSS_STREAK_LONG_COOLDOWN_MIN=120
# enforce = cooldown blocks entries. shadow = trades anyway, tags them, recap compares
COOLDOWN_MODE=enforce
REVENGE_BAN_HOURS=24

# ── LIVE ONLY — leave blank until paper clears ./desk golive ────────────────
# Use a fresh wallet funded with only what you can afford to lose.
WALLET_PRIVATE_KEY=
LIVE_CONFIRM=
